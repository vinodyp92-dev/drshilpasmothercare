# Clinic contact (edit src/context/ClinicConfigContext.tsx to update)

# Optional: override at build time on Vercel (Settings → Environment Variables)
# VITE_CLINIC_WHATSAPP=919900188776

# Google Sheet booking sync — SERVER ONLY (no VITE_ prefix; never exposed to the browser)
# 1. Create a Sheet, paste google-apps-script/BookingApi.gs into Apps Script
# 2. Set SCRIPT_SECRET in the script to match BOOKING_SCRIPT_SECRET
# 3. Deploy as Web app (Anyone) and paste the URL below
# 4. On Vercel: add both as Sensitive / encrypted env vars (not "Build" client config)
# BOOKING_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
# BOOKING_SCRIPT_SECRET=your-long-random-secret
